# Renseignez UNE des deux clés :
# - OpenAI  : clé fournie par l'enseignant
# - Mistral : clé gratuite à créer sur https://console.mistral.ai (offre "Experiment")
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optionnel : forcer le fournisseur ("openai" ou "mistral").
# Par défaut : openai si OPENAI_API_KEY est renseignée, sinon mistral.
# LLM_PROVIDER=

# Optionnel : changer les modèles
# (défauts OpenAI : gpt-6-luna / text-embedding-3-small ; Mistral : mistral-small-latest / mistral-embed)
# CHAT_MODEL=
# EMBEDDING_MODEL=

# Traçage LangSmith (optionnel) : passer à "true" et renseigner la clé
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=
